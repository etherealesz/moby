{
  "name": "trashnav-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=.env -- next dev",
    "start": "bun --env-file=.env -- next start",
    "build": "bun --env-file=.env -- next build",
    "analyze": "ANALYZE=true bun --env-file=.env -- next build",
    "typecheck": "tsc --noEmit",
    "lint": "bun run eslint && bun run stylelint",
    "eslint": "eslint .",
    "stylelint": "stylelint '**/*.css' --cache",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "bun next typegen && bun run prettier:check && bun run lint && bun run typecheck && bun run jest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@mantine/carousel": "^8.3.6",
    "@mantine/charts": "^8.3.6",
    "@mantine/code-highlight": "^8.3.6",
