    "@mantine/dates": "^8.3.6",
    "@mantine/dropzone": "^8.3.6",
    "@mantine/form": "^8.3.6",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@mantine/nprogress": "^8.3.6",
    "@mantine/spotlight": "^8.3.6",
    "@mantine/tiptap": "^8.3.6",
    "@next/bundle-analyzer": "^16.0.0",
    "@tabler/icons-react": "^3.35.0",
    "@tiptap/extension-link": "^3.10.2",
    "@tiptap/pm": "^3.10.2",
    "@tiptap/react": "^3.10.2",
    "@tiptap/starter-kit": "^3.10.2",
    "ag-grid-enterprise": "^35.0.0",
    "ag-grid-react": "^35.0.1",
    "ahooks": "^3.9.7",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "immer": "^11.0.0",
    "js-cookie": "^3.0.5",
    "leaflet": "^1.9.4",
    "lint-staged": "^16.2.7",
    "mantine-form-zod-resolver": "^1.3.0",
    "next": "16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "swr": "^2.3.8",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.37.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@storybook/addon-themes": "^10.0.0",
    "@storybook/nextjs": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.7.1",
    "@types/react": "19.2.6",
